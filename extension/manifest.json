{
  "manifest_version": 3,
  "name": "알림 띠",
  "version": "1.0.0",
  "description": "새 메시지가 오면 보고 있는 웹페이지 맨 위에 내가 정한 문구의 알림 띠를 띄워요.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://uzzyadqvshwtrqsaexbr.supabase.co/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html", "default_title": "알림 띠 설정" },
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
}
